# Base URL of your paperless-ngx install. A trailing /api is stripped, so either form works.
PAPERLESS_URL=https://paperless.example.com

# API token: paperless web UI -> user menu -> My Profile -> circular arrow next to API Token.
PAPERLESS_TOKEN=

# Alternative to a token. Ignored when PAPERLESS_TOKEN is set.
# PAPERLESS_USERNAME=
# PAPERLESS_PASSWORD=

# Refuse every mutating tool. Good for letting an assistant explore before granting write access.
# PAPERLESS_READ_ONLY=1

# Where downloaded files land. Defaults to $TMPDIR/paperless-mcp.
# PAPERLESS_DOWNLOAD_DIR=

# Pin the REST API version. Leave unset to accept the server's own default.
# PAPERLESS_API_VERSION=10

# Per-request timeout in milliseconds.
# PAPERLESS_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Transport. Leave unset for stdio, which is what MCP clients spawn directly.
# Set MCP_TRANSPORT=http to run one long-lived server on a port instead.
# ---------------------------------------------------------------------------

# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8765
# MCP_HTTP_PATH=/mcp

# Require `Authorization: Bearer <token>` on every HTTP request. Strongly
# recommended whenever the port is reachable by anything but this machine.
# Generate one with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Host/Origin allowlists for DNS-rebinding protection. Defaults to localhost
# only. Comma-separated; `*` disables the respective check.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# MCP_ALLOWED_ORIGINS=
