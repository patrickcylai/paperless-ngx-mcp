{
    "name": "@patrickcylai/paperless-ngx-mcp",
    "version": "0.1.0",
    "description": "Model Context Protocol server for paperless-ngx — search, read, file and upload documents in your archive.",
    "keywords": [
        "mcp",
        "modelcontextprotocol",
        "model-context-protocol",
        "paperless-ngx",
        "paperless",
        "documents",
        "dms",
        "ocr"
    ],
    "license": "MIT",
    "author": "Patrick Lai",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/patrickcylai/paperless-ngx-mcp.git"
    },
    "homepage": "https://github.com/patrickcylai/paperless-ngx-mcp#readme",
    "bugs": "https://github.com/patrickcylai/paperless-ngx-mcp/issues",
    "type": "module",
    "bin": {
        "paperless-ngx-mcp": "dist/index.js"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": ["dist", ".claude-plugin/plugin.json", ".mcp.json", "README.md", "LICENSE"],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22.6.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "watch": "tsc -p tsconfig.build.json --watch",
        "start": "node dist/index.js",
        "dev": "node src/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --test 'test/*.test.ts'",
        "prepublishOnly": "npm run typecheck && npm test && npm run build"
    },
    "dependencies": {
        "@modelcontextprotocol/server": "^2.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "typescript": "^7.0.2"
    }
}
